# ==============================================================================
# Quantellix / Sriya AI Environment Configuration Template
# Duplicate this file as '.env' in the project root directory
# ==============================================================================

# Core App Settings
SECRET_KEY=django-insecure-change-this-to-a-random-secret-key-in-production
DEBUG=true
ALLOWED_HOSTS=127.0.0.1,localhost

# Deployment Mode
SRIYA_DEPLOYMENT=local
SRIYA_WEB_MODE=true
LICENSE_FULFILL_LOCALLY=true

# Product & Pricing
SRIYA_PRODUCT_NAME=Sriya AI Chatbot
SRIYA_ANNUAL_PRICE_USD=9999
SRIYA_EXTRA_USE_PRICE_USD=999

# AI Models & LLM APIs
# Google Gemini API (Get free key: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Optional / for OpenAI agent models)
OPENAI_API_KEY=your_openai_api_key_here

# Database Configuration (PostgreSQL / Neon or SQLite)
# For local SQLite, leave blank or specify postgresql url for Neon / remote DB:
DATABASE_URL=sqlite:///db.sqlite3

# Stripe Payment Gateway (Optional for billing features)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ANNUAL_PRICE_ID=
STRIPE_EXTRA_USE_PRICE_ID=

# Email / License Notifications (Optional)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
